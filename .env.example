# Duckrep is local-first. No environment variables are required for web or desktop.

# Optional: passphrase used once, for first-time setup of the lock, instead of asking.
# It is compiled into the bundle: change it afterwards in Settings -> Security, and never set it on a public deploy.
VITE_DUCKREP_PASSWORD=

# Optional analytics (consent-gated, Google Consent Mode v2). Leave empty to keep analytics off.
# GA4/GTM: set the ID in Vercel and redeploy.
VITE_GTM_ID=
VITE_GA_ID=
